APP_NAME=InventoryFlow
APP_ENV=development
DATABASE_URL=sqlite:///./inventoryflow.db
SESSION_HOURS=12
COOKIE_SECURE=false
ERP_PROVIDER=demo
ALLOW_EXTERNAL_CONNECTIONS=false
COUNT_LOCK_TTL_SECONDS=1800
RECOUNT_LOCK_TTL_SECONDS=1800

# Optional: PostgreSQL/Supabase direct connection
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Optional: Bling OAuth 2.0. Never commit real credentials.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://127.0.0.1:10000/api/v1/integrations/bling/callback

# Required only when external OAuth tokens are stored.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
